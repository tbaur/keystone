{
  "name": "keystone",
  "version": "0.2.3",
  "private": true,
  "description": "Keystone for Homebridge: one page for several Homebridge instances, with status, child bridges, and one merged, streaming log.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p src/web/tsconfig.json && cp src/web/*.html src/web/*.css src/web/*.svg dist/web/",
    "start": "node --disable-warning=ExperimentalWarning dist/server/main.js",
    "dev:fake": "node --disable-warning=ExperimentalWarning scripts/fake-homebridge.ts",
    "secrets": "node --disable-warning=ExperimentalWarning dist/server/cli/secrets.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "socket.io": "4.8.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
